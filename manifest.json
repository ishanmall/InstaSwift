{
  "manifest_version": 3,
  "name": "InstaSwift v10.0 - Clean Grid & Reels Downloader",
  "version": "10.0.0",
  "description": "Simple 2-section Instagram downloader: 1) Main Posts Grid 2) Reels Tab with strict cross-tab deduplication.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaSwift v10.0"
  }
}
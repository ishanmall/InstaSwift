{
  "manifest_version": 3,
  "name": "InstaSwift v17.0 - Anti-Freeze Background Profile, Reels & HD Story Downloader",
  "version": "17.0.0",
  "minimum_chrome_version": "109",
  "description": "Never freezes when Chrome is minimized to VS Code! Continuous Audio/WebLock Wake Engine + 100% Grid & Reels Scanner.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "offscreen",
    "cookies",
    "idle"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaSwift v17.0"
  }
}
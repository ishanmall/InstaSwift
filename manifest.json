{
  "manifest_version": 3,
  "name": "InstaSwift v38.0 — 4-Engine Auto-Scroll + GraphQL Cloner 3-Room Downloader",
  "version": "38.0.0",
  "minimum_chrome_version": "109",
  "description": "Bypasses 17-item rate-limit using Live GraphQL Request Cloning + High-Speed Auto-Scroll + 3-Room Deduplication.",
  "permissions": [
    "downloads",
    "activeTab",
    "tabs",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaSwift v38.0"
  }
}
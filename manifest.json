{
  "manifest_version": 3,
  "name": "InstaSwift v29.0 — 3-Room Bulk + Single Video & Story Downloader",
  "version": "29.0.0",
  "minimum_chrome_version": "109",
  "description": "One-pass Grid & Reels 3-Room Scanner + Particular Single Video/Reel/Post Downloader + HD Story Downloader.",
  "permissions": [
    "downloads",
    "activeTab",
    "tabs",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaSwift v29.0"
  }
}
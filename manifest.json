{
  "manifest_version": 3,
  "name": "InstaSwift v16.0 - Tab-Independent Background Grid, Reels & HD Story Downloader",
  "version": "16.0.0",
  "minimum_chrome_version": "109",
  "description": "Works from ANY tab (/reels/ or Main Grid)! Scans 100% Grid Posts & Unique Reels in Background + Zero Duplicates.",
  "permissions": [
    "downloads",
    "storage",
    "activeTab",
    "tabs",
    "alarms",
    "offscreen",
    "cookies"
  ],
  "host_permissions": [
    "https://*.instagram.com/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "InstaSwift v16.0"
  }
}